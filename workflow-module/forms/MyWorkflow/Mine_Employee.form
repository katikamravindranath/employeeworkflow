{
    "id": "mine_employee",
    "schemaVersion": "1.1.0",
    "name": "Mine_Employee",
    "revision": "1.0",
    "type": "task",
    "readOnly": false,
    "content": [
        {
            "id": "FormData",
            "type": "section",
            "title": "Form_Data",
            "content": [
                {
                    "id": "id",
                    "type": "integer",
                    "label": "Username",
                    "readOnly": false,
                    "value": "${context.employeedata.UserName}",
                    "constraints": {
                        "required": false
                    }
                },
                {
                    "id": "name",
                    "type": "string",
                    "label": "Name",
                    "readOnly": false,
                    "value": "${context.employeedata.FirstName}",
                    "constraints": {
                        "required": false
                    }
                },
                {
                    "id": "description",
                    "type": "string",
                    "label": "Gender",
                    "readOnly": false,
                    "value": "${context.employeedata.Gender}",
                    "constraints": {
                        "required": false
                    }
                },
                {
                    "id": "release_date",
                    "type": "string",
                    "label": "Address",
                    "readOnly": false,
                    "value": "${context.employeedata.AddressInfo[0].Address}",
                    "constraints": {
                        "required": false
                    }
                },
                {
                    "id": "discontinueddate",
                    "type": "string",
                    "label": "City",
                    "readOnly": false,
                    "value": "${context.employeedata.AddressInfo[0].City.Name}",
                    "constraints": {
                        "required": false
                    }
                }
            ]
        }
    ],
    "decisions": [
        {
            "id": "approve",
            "text": "Approve",
            "decisionType": "positive"
        }
    ],
    "attachments": {}
}